root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# All four values below are already ktlint_official defaults. They are set explicitly
# because IntelliJ's own formatter (Ctrl+Alt+L) does not know the ktlint defaults and
# would otherwise format code that ktlintCheck then rejects.
ktlint_code_style = ktlint_official
max_line_length = 140
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Never collapse imports into wildcards. IntelliJ defaults to '*' after 5 classes (or 3
# members) from the same package, which conflicts with ktlint's no-wildcard-imports rule.
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
# Clears IntelliJ's built-in on-demand list (java.util.*, kotlinx.android.synthetic.**).
ij_kotlin_packages_to_use_import_on_demand = unset

# The kvalitetsvurdering property names are part of the REST contract towards the Kabal
# frontend and of the Excel export column mapping. Many of them are longer than 140
# characters on their own, so no amount of wrapping brings these files below the limit.
# Shortening the names would be a breaking change, hence the limit is lifted here only.
# Turning max_line_length off (rather than suppressing standard:max-line-length) also
# relaxes the wrapping rules that derive their threshold from the same value.
[{**/services/ExportServiceV1.kt,**/services/ExportServiceV2.kt,**/services/ExportServiceV3.kt,**/api/view/KvalitetsvurderingV2View.kt,**/api/view/KvalitetsvurderingV3View.kt,**/api/view/CensoredKvalitetsvurderingV2View.kt,**/api/view/CensoredKvalitetsvurderingV3View.kt,**/kvalitetsvurdering/v2/KvalitetsvurderingV2.kt,**/repositories/KvalitetsvurderingV3RepositoryTest.kt}]
max_line_length = off

[*.{yaml,yml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
